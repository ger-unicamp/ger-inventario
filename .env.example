# Copie para .env e preencha. NAO versione o .env: ele contem a chave privada.

# ID da planilha: o trecho entre /d/ e /edit na URL do Google Sheets.
# https://docs.google.com/spreadsheets/d/ESTE_PEDACO_AQUI/edit
GOOGLE_SHEETS_ID=

# Nome da aba. Deixe assim, a menos que tenha um motivo.
GOOGLE_SHEETS_ABA=Inventario

# Aba com a lista de locais (moveis e zonas). Criada pelo npm run init-sheet.
GOOGLE_SHEETS_ABA_LOCAIS=Locais

# Aba com o registro de emprestimos. Criada pelo npm run init-sheet.
GOOGLE_SHEETS_ABA_EMPRESTIMOS=Emprestimos

# Do JSON da service account: campo "client_email".
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Do JSON da service account: campo "private_key", INTEIRO, entre aspas duplas,
# com os \n literais preservados exatamente como vieram no arquivo.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
